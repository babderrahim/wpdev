# Compose project name: namespaces containers, volumes and networks.
# Change it (and the ports) to run a second checkout side by side.
COMPOSE_PROJECT_NAME=wpdev

WP_PORT=8080
MAIL_PORT=8025

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

WP_TITLE=WP Dev
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.test
WP_LOCALE=en_US

# off | debug | develop,debug | profile ...  (use `make xdebug-on` to toggle temporarily)
XDEBUG_MODE=off

# Container user = your host user, so files in wp-content stay owned by you.
# Filled in automatically from `id -u` / `id -g` when .env is created.
HOST_UID=1000
HOST_GID=1000
